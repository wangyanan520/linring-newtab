{
  "name": "lingrui-nav",
  "version": "1.0.0",
  "private": true,
  "description": "凌睿科技导航页 — 最小测试工程（PBI-15 起点；无构建，原生 JS）",
  "scripts": {
    "test": "node --test \"凌睿科技导航页/scripts/__tests__/*.test.js\"",
    "test:coverage": "node --experimental-test-coverage --test \"凌睿科技导航页/scripts/__tests__/*.test.js\"",
    "test:e2e": "node 凌睿科技导航页/scripts/__tests__/e2e/nav-e2e.js",
    "test:e2e:preview": "node 凌睿科技导航页/scripts/__tests__/e2e/nav-e2e.js --preview",
    "test:e2e:shim": "node 凌睿科技导航页/scripts/__tests__/e2e/nav-e2e.js --shim",
    "pack": "npm test && node scripts/pack.js",
    "pack:zip": "node scripts/pack.js"
  },
  "devDependencies": {
    "playwright": "^1.57.0"
  }
}
